#!/bin/sh
# Rogue Rigs pre-commit: regenerate vault/_paths.md, then enforce the vault invariants.
# Installed (repo root) with:  git config core.hooksPath vault/scripts/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
node vault/scripts/lint.js --write >/dev/null || { node vault/scripts/lint.js; exit 1; }
git add vault/_paths.md
node vault/scripts/lint.js
